{
    "root": false,
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "files": {
        "includes": ["src/**/*.ts"]
    },
    "linter": {
      "rules": {
        "correctness": {
          "useImportExtensions": {
            "level": "error",
            "options": {
              "forceJsExtensions": true
            }
          }
        }
      }
    }
}
